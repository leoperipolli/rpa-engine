# ── Local development (pnpm dev) ─────────────────────────────
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rpa
REDIS_URL=redis://localhost:6379
DASHBOARD_URL=http://localhost:3001
PLAYWRIGHT_HEADLESS=true
WORKER_CONCURRENCY=1

# 32 bytes as 64 hex characters (encrypts recipe secrets; backend and runner must share it)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# API key used by the dashboard and external clients (header X-API-Key)
API_KEY=

# ── Production (docker-compose.prod.yml) ─────────────────────
DOMAIN=rpa.example.com
POSTGRES_PASSWORD=
AUTH_USERNAME=
AUTH_PASSWORD=
AUTH_SECRET=
